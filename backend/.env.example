# Copy to backend/.env. Never put these values in frontend VITE_* variables.
DATABASE_URL=postgresql+psycopg://ps1:local-development-only@127.0.0.1:55432/ps1
# Generate your own random credential, at least 24 characters.
APP_API_TOKEN=replace-with-a-random-local-token
# Local/default ceiling is 12 MiB. Vercel's entrypoint caps uploads at 4 MiB.
# MAX_PDF_BYTES=12582912
OPENAI_API_KEY=
# Provisional winner on six synthetic fixtures; verify account access in your environment.
OPENAI_MODEL=gpt-6-luna
# Default server mode preserves the original operator-key configuration.
# For reviewer-entered keys, set reviewer and provide the same stable Fernet encryption
# secret privately to API and worker. Reviewer keys are never copied to this file.
# OPENAI_CREDENTIAL_MODE=reviewer
# BYOK_ENCRYPTION_KEY=generate-a-Fernet-key-and-store-only-in-server-secrets
# Case-study role profile: three fixed submitter tokens and one financial reviewer.
# APP_API_TOKEN identifies submitter; generate each other token once, keep it stable,
# and give each person only their own token. These are separate from OpenAI keys.
# ACCESS_MODE=roles
# SUBMITTER_API_TOKENS={"submitter-b":"generate-unique-submit-b-token-at-least-24","submitter-c":"generate-unique-submit-c-token-at-least-24"}
# Shared mode remains only for existing demo compatibility; it does not isolate submitters.
# Optional, separate credential with at least 24 characters; required to submit reviews.
# REVIEWER_API_TOKEN=generate-a-separate-local-reviewer-secret
# Optional: generated by the disposable demo tool; omit for the default schema.
# DATABASE_SCHEMA=ps1_demo_generated_by_script
# Optional: serve the built static UI from the API at the same origin.
# FRONTEND_DIRECTORY=../frontend/dist
