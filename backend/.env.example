# Copy to backend/.env. Never put these values in frontend VITE_* variables.
DATABASE_URL=postgresql+psycopg://ps1:local-development-only@127.0.0.1:55432/ps1
# Generate your own random credential, at least 24 characters.
APP_API_TOKEN=replace-with-a-random-local-token
OPENAI_API_KEY=
# Deliberately unset until the account/model benchmark is complete.
OPENAI_MODEL=
