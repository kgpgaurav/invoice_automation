{
  "name": "ps1-invoice-ui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "check:types": "tsc --noEmit && tsc -p tsconfig.browser.json",
    "preview": "vite preview --host 127.0.0.1",
    "generate:api": "openapi-typescript openapi.json -o src/api.generated.ts",
    "format:check": "prettier --check src tests playwright.config.ts",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "5.3.0",
    "@phosphor-icons/react": "2.1.10",
    "pdfjs-dist": "^6.5.438",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@tailwindcss/vite": "^4.1.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.4.0",
    "openapi-typescript": "^7.6.0",
    "prettier": "^3.10.0",
    "tailwindcss": "^4.1.0",
    "typescript": "~5.8.3",
    "vite": "^6.3.0"
  }
}
